---
/**
 * Every chart the pipeline has drawn, rendered by the components the articles
 * use. This is the development loop: `llmango analyze` rewrites an SVG, the dev
 * server reloads, and what you are looking at is what ships.
 */
import Article from "../layouts/Article.astro";
import Figure from "../components/Figure.astro";
import { questions } from "../data/charts";
---

<Article title="llmango charts" description="Every chart the pipeline has drawn.">
  <h1>Charts</h1>
  <p class="lede">
    Every figure the pipeline currently draws, in the same components the articles
    use. Regenerate them with <code>just analyze 001a</code>.
  </p>

  {
    questions.map((entry) => (
      <section>
        <h2>{entry.question_id}</h2>
        {entry.charts.map((chart) => (
          <Figure
            question={entry.question_id}
            file={chart.file}
            alt=""
            caption={chart.title}
          />
        ))}
      </section>
    ))
  }
</Article>
