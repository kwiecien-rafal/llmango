---
/**
 * One chart: the drawn SVG plus the table of numbers behind it.
 *
 * The SVG's text is outlined paths, so the table is not an extra - it is how
 * those numbers stay readable, copyable and searchable. alt is required rather
 * than generated: a sentence describing the table's dimensions tells a screen
 * reader nothing, and a page whose content is the figure plus its table passes
 * alt="". The two renditions are the same chart drawn at the two widths the page
 * reads it at, since point sizes are declared rather than scaled.
 */
import { chart as findChart, chartSrc } from "../data/charts";
import Numbers from "./Numbers.astro";

interface Props {
  experiment: string;
  chart: string;
  alt: string;
}

const { experiment, chart, alt } = Astro.props;
const entry = findChart(experiment, chart);
---

<figure class="chart">
  <picture>
    <source
      media="(max-width: 30rem)"
      srcset={chartSrc(experiment, entry.narrow_file)}
    />
    <img src={chartSrc(experiment, entry.file)} alt={alt} loading="lazy" />
  </picture>
  <figcaption>Datasets: {entry.questions.join(", ")}</figcaption>
  <details>
    <summary>Numbers behind this chart</summary>
    <Numbers
      experiment={experiment}
      row_label={entry.row_label}
      unit={entry.unit}
      columns={entry.columns}
      rows={entry.rows}
    />
  </details>
</figure>
