---
/**
 * The numbers the pipeline wrote, as the table a reader can copy out of.
 *
 * A figure keeps this behind a disclosure, beside the drawing it belongs to. A
 * table the pipeline drew nothing for is this alone, so the markup lives here
 * rather than in either of them.
 *
 * Annotated, a drawn column splits into the numbers behind one estimate: the
 * number plotted, the tally it was counted from and the interval around it. Each
 * is a column of its own under the name of the column drawn, so a reader compares
 * one kind of number down a column rather than reading it out of a sentence
 * written beside the last. A sample size the whole column shares is said once, in
 * that column's heading, and only a column whose rows were counted out of
 * different samples spends a column of its own on it. A table that is itself the
 * thing being read carries those columns already, so it prints the numbers alone.
 */
import { chartSrc, type Row } from "../data/charts";

interface Props {
  experiment: string;
  row_label: string;
  unit: string;
  columns: string[];
  rows: Row[];
  title?: string;
  annotated?: boolean;
}

const {
  experiment,
  row_label,
  unit,
  columns,
  rows,
  title,
  annotated = true,
} = Astro.props;

/** One drawn column: its name, what it was counted out of, its headings and numbers. */
const groups = columns.map((column, index) => {
  const cells = rows.map((row) => row.cells[index]);
  const counted = cells.every((cell) => cell.count !== undefined);
  const shared = new Set(cells.map((cell) => cell.n)).size === 1;

  return {
    name: column,
    sample: shared ? `n = ${cells[0].n}` : undefined,
    headings: [
      unit,
      ...(counted ? ["count"] : []),
      ...(shared ? [] : ["n"]),
      "95% CI",
    ],
    numbers: cells.map((cell) => [
      cell.written,
      ...(counted ? [cell.count ?? cell.n] : []),
      ...(shared ? [] : [cell.n]),
      cell.written_interval ?? "",
    ]),
  };
});
---

<div class="scroll">
  <table class:list={{ grouped: annotated, even: groups.length === 1 }}>
    {title && <caption>{title}</caption>}
    <thead>
      {
        annotated ? (
          <Fragment>
            <tr>
              <th scope="col" rowspan="2">
                {row_label}
              </th>
              {groups.map((group) => (
                <th
                  scope="colgroup"
                  colspan={group.headings.length}
                  class="group"
                >
                  {group.name}
                  {group.sample && <span class="sample">{group.sample}</span>}
                </th>
              ))}
            </tr>
            <tr>
              {groups.map((group) =>
                group.headings.map((heading, index, headings) => (
                  <th
                    scope="col"
                    class:list={{
                      group: index === 0,
                      interval: index === headings.length - 1,
                    }}
                  >
                    {heading}
                  </th>
                )),
              )}
            </tr>
          </Fragment>
        ) : (
          <tr>
            <th scope="col">{row_label}</th>
            {columns.map((column) => (
              <th scope="col">{column}</th>
            ))}
          </tr>
        )
      }
    </thead>
    <tbody>
      {
        rows.map((row, index) => (
          <tr>
            <th scope="row">
              {row.icon && (
                <img
                  class="icon"
                  src={chartSrc(experiment, row.icon)}
                  alt=""
                  loading="lazy"
                />
              )}
              {row.label}
            </th>
            {annotated
              ? groups.map((group) =>
                  group.numbers[index].map((number, at, numbers) => (
                    <td
                      class:list={{
                        group: at === 0,
                        interval: at === numbers.length - 1,
                      }}
                    >
                      {number}
                    </td>
                  )),
                )
              : row.cells.map((cell) => <td>{cell.written}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
